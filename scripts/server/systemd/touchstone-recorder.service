[Unit]
Description=Touchstone market data recorder
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=0

[Service]
# systemd supervises the container, not a Docker restart policy, because Docker treats docker kill
# as a deliberate stop and leaves the container down. To stop recording, use systemctl stop.
EnvironmentFile=/etc/touchstone/env
Restart=always
RestartSec=5
TimeoutStopSec=60
ExecStartPre=-/usr/bin/docker rm -f touchstone-recorder
ExecStart=/usr/bin/docker run --rm --name touchstone-recorder \
    --log-driver=journald \
    --env POLARS_MAX_THREADS=2 \
    --volume /var/lib/touchstone/data:/data \
    touchstone-recorder:current \
    python -m touchstone.recorder run --data-dir /data --products ${TOUCHSTONE_PRODUCTS}
ExecStop=/usr/bin/docker stop --time 30 touchstone-recorder

[Install]
WantedBy=multi-user.target
